<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.black-hole-wallpaper" path="/org/gnome/shell/extensions/black-hole-wallpaper/">
    <key name="mode" type="s">
      <choices>
        <choice value="single"/>
        <choice value="pair"/>
      </choices>
      <default>'single'</default>
      <summary>Show one object or a pair orbiting each other</summary>
    </key>
    <key name="first-object" type="s">
      <choices>
        <choice value="black-hole"/>
        <choice value="neutron-star"/>
        <choice value="star"/>
        <choice value="wormhole"/>
      </choices>
      <default>'black-hole'</default>
      <summary>The object in single mode, and the first object of a pair</summary>
    </key>
    <key name="second-object" type="s">
      <choices>
        <choice value="black-hole"/>
        <choice value="neutron-star"/>
        <choice value="star"/>
        <choice value="wormhole"/>
      </choices>
      <default>'black-hole'</default>
      <summary>The second object of a pair</summary>
    </key>
    <key name="events" type="b">
      <default>true</default>
      <summary>Play cosmic events: mergers, devoured stars and supernovae</summary>
    </key>
    <key name="background" type="s">
      <choices>
        <choice value="stars"/>
        <choice value="milky-way"/>
      </choices>
      <default>'milky-way'</default>
      <summary>Sky behind the objects</summary>
    </key>
    <key name="orbit-speed" type="u">
      <range min="0" max="400"/>
      <default>100</default>
      <summary>How fast a pair orbits, in percent</summary>
    </key>
    <key name="char-size" type="u">
      <range min="1" max="8"/>
      <default>3</default>
      <summary>Size of one font dot in screen pixels</summary>
    </key>
    <key name="fps" type="u">
      <range min="5" max="60"/>
      <default>30</default>
      <summary>Frames rendered per second</summary>
    </key>
    <key name="pause-when-covered" type="b">
      <default>true</default>
      <summary>Pause the animation while a maximized or fullscreen window covers the monitor</summary>
    </key>
    <key name="follow-cursor" type="b">
      <default>true</default>
      <summary>Turn the camera toward the cursor</summary>
    </key>
    <key name="cursor-sensitivity" type="u">
      <range min="0" max="200"/>
      <default>50</default>
      <summary>How far the camera turns when the cursor reaches the screen edge</summary>
    </key>
    <key name="cursor-smoothing" type="u">
      <range min="0" max="100"/>
      <default>40</default>
      <summary>How slowly the camera follows the cursor</summary>
    </key>
    <key name="rotation-speed" type="u">
      <range min="0" max="400"/>
      <default>100</default>
      <summary>Accretion disk rotation speed in percent</summary>
    </key>
    <key name="elevation" type="i">
      <range min="-30" max="60"/>
      <default>8</default>
      <summary>Camera height above the disk in degrees</summary>
    </key>
    <key name="tilt" type="i">
      <range min="-45" max="45"/>
      <default>9</default>
      <summary>Camera roll in degrees</summary>
    </key>
    <key name="zoom" type="u">
      <range min="25" max="400"/>
      <default>100</default>
      <summary>Zoom in percent</summary>
    </key>
    <key name="brightness" type="u">
      <range min="25" max="400"/>
      <default>100</default>
      <summary>Exposure in percent</summary>
    </key>
    <key name="doppler" type="u">
      <range min="0" max="100"/>
      <default>40</default>
      <summary>Strength of the relativistic Doppler brightening in percent</summary>
    </key>
  </schema>
</schemalist>
